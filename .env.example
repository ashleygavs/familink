APP_NAME=FamiLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# On a live site use APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error and the https address in APP_URL.
# Behind a load balancer, list its addresses (comma separated) so visitors cannot fake theirs. Only the local computer is trusted by default.
# TRUSTED_PROXIES=127.0.0.1,::1
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# FamiLink runs on MariaDB 11.4 (the tests also run once against it, see WALKTHROUGH.md). Use a limited user
# that can reach only this database, not root: scripts/database/setup-familink-mariadb.ps1 creates one.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=familink
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when the site is served over HTTPS, so the login cookie never travels unencrypted.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Show Forgot your password? on the login page. Turn on only when mail really works.
SHOW_PASSWORD_RESET_LINK=false
